#!/usr/bin/env bash
# Prepares a fresh orb: pinned Node (from .nvmrc), pnpm (self-managed from package.json
# packageManager), and locked dependencies. Idempotent; a warm run only checks versions and runs a
# no-op install.
#
# Node is installed under ~/.local/share and linked into /usr/local/bin, replacing the orb's stock
# node/npm/npx/corepack links so Amp, services and login shells get the pinned version. Only the
# link in /usr/local/bin matters: no other node is earlier on PATH. .nvmrc must hold an exact
# x.y.z version.
set -euo pipefail

cd "$(dirname "$0")/.."
repo_root="$(pwd)"

step() { printf '\n==> %s (%s)\n' "$1" "$(date +%T)"; }

# --- Node: match .nvmrc ---
step "Node"
want_node="$(tr -d '[:space:]' < .nvmrc)"
want_node="${want_node#v}"
if [[ "$(node -v 2>/dev/null || true)" != "v$want_node" ]]; then
  arch="$(uname -m)"; case "$arch" in x86_64) arch=x64 ;; aarch64) arch=arm64 ;; esac
  node_dir="$HOME/.local/share/node-v$want_node"
  # npm's package.json is extracted late in the tarball, so it marks a complete install.
  if [[ ! -f "$node_dir/lib/node_modules/npm/package.json" ]]; then
    name="node-v$want_node-linux-$arch.tar.xz"
    base="https://nodejs.org/dist/v$want_node"
    mkdir -p "$HOME/.local/share"
    tmp="$(mktemp -d "$HOME/.local/share/.node-XXXXXX")"
    trap 'rm -rf "$tmp"' EXIT
    curl -fsSL --retry 3 -o "$tmp/$name" "$base/$name"
    curl -fsSL --retry 3 -o "$tmp/SHASUMS256.txt" "$base/SHASUMS256.txt"
    (cd "$tmp" && grep -F " $name" SHASUMS256.txt | sha256sum -c -)
    mkdir "$tmp/node"
    tar -xJf "$tmp/$name" -C "$tmp/node" --strip-components=1
    rm -rf "$node_dir"
    mv "$tmp/node" "$node_dir"
    rm -rf "$tmp"; trap - EXIT
  fi
  for bin in node npm npx corepack; do
    sudo -n ln -sf "$node_dir/bin/$bin" "/usr/local/bin/$bin"
  done
  hash -r
fi
echo "node $(node -v)"

# --- pnpm ---
# pnpm 12 switches itself to package.json's packageManager version inside the repo (and caches it
# under ~/.local/share/pnpm), so there is nothing to install here.
step "pnpm"
echo "pnpm $(pnpm --version)"

# --- Dependencies ---
step "pnpm install"
cd "$repo_root"
pnpm install --frozen-lockfile

step "done"
